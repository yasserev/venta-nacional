# =========================================================
# PLANTILLA DE VARIABLES DE ENTORNO — Venta Nacional Camposol
# Copia este archivo a .env y rellena con tus valores reales.
# NUNCA subas el archivo .env a Git.
# En Vercel: configura estas variables en Settings > Environment Variables
# =========================================================

# Puerto del servidor backend (Vercel lo ignora, usa el suyo)
PORT=3000

# JWT Secret — usa una cadena aleatoria de 64+ caracteres
# Genera una en: https://generate-secret.vercel.app/64
JWT_SECRET=REEMPLAZA_CON_UNA_CLAVE_ALEATORIA_SEGURA_DE_64_CARACTERES

# URL de conexión a la base de datos PostgreSQL (Neon.tech)
# Formato: postgresql://usuario:contraseña@host/nombre_db?sslmode=require
DATABASE_URL=postgresql://usuario:contraseña@host/nombre_db?sslmode=require

# Orígenes permitidos en CORS (separados por coma)
# Ej: https://mi-app.vercel.app,https://mi-dominio.com
ALLOWED_ORIGINS=http://localhost:5173
